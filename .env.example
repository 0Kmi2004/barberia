APP_ENV=development
DEBUG=true
PORT=3000
APP_NAME=Barberia
APP_URL=http://localhost:8080

# EMAIL CONFIGURATION
EMAIL_FROM=no-reply@barberia.local
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# MYSQL DATABASE CONFIGURATION
DB_NAME=barberia
DB_USER=barberia
DB_PASSWORD=replace-with-a-local-password
# Docker specific property, not used in the application, but required for the MySQL container to start.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# JWT SECRET
JWT_SECRET=replace-with-a-long-random-secret
